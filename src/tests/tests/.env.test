# E2E Test Environment Variables
# Copy this file to .env.test and fill in your values

# Test user credentials
E2E_TEST_EMAIL=testuser@example.com
E2E_TEST_PASSWORD=Testpassword123!

# Demo user (if different from test user)
E2E_DEMO_EMAIL=demo@example.com
E2E_DEMO_PASSWORD=demo

# Base URLs
BASE_URL_ACCOUNTS=http://localhost:5991
BASE_URL_ETL=http://localhost:5992
BASE_URL_OPEN_KB=http://localhost:5995
BASE_URL_STOQR=http://localhost:5993
BASE_URL_UI_DESIGN=http://localhost:5999

# Optional Supabase service access for auth setup helpers
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# If true, Playwright will also start Accounts app via `pnpm dev:accounts`
E2E_WITH_ACCOUNTS=true

# If true, enables deeper mutation-heavy accounts coverage.
# Keep false for smoke-only accounts runs.
E2E_ACCOUNTS_DEEP=false
