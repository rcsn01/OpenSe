---
import dashboardDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-dashboard-desktop.webp'
import dashboardMobileImage from '../assets/marketing/stoqr/optimized/stoqr-dashboard-mobile.webp'
import inventoryDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-inventory-desktop.webp'
import inventoryMobileImage from '../assets/marketing/stoqr/optimized/stoqr-inventory-mobile.webp'
import labelEditorDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-label-editor-desktop.webp'
import labelEditorMobileImage from '../assets/marketing/stoqr/optimized/stoqr-label-editor-mobile.webp'
import labelPrintDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-label-print-desktop.webp'
import labelPrintMobileImage from '../assets/marketing/stoqr/optimized/stoqr-label-print-mobile.webp'
import organisationRoleEditorDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-organisation-role-editor-desktop.webp'
import organisationRoleEditorMobileImage from '../assets/marketing/stoqr/optimized/stoqr-organisation-role-editor-mobile.webp'
import organisationTeamsDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-organisation-teams-desktop.webp'
import organisationTeamsMobileImage from '../assets/marketing/stoqr/optimized/stoqr-organisation-teams-mobile.webp'
import procurementPurchaseOrdersDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-procurement-purchase-orders-desktop.webp'
import procurementPurchaseOrdersMobileImage from '../assets/marketing/stoqr/optimized/stoqr-procurement-purchase-orders-mobile.webp'
import procurementSuppliersDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-procurement-suppliers-desktop.webp'
import procurementSuppliersMobileImage from '../assets/marketing/stoqr/optimized/stoqr-procurement-suppliers-mobile.webp'
import reportInventoryDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-report-inventory-desktop.webp'
import reportInventoryMobileImage from '../assets/marketing/stoqr/optimized/stoqr-report-inventory-mobile.webp'
import reportPurchasingDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-report-purchasing-desktop.webp'
import reportPurchasingMobileImage from '../assets/marketing/stoqr/optimized/stoqr-report-purchasing-mobile.webp'
import reportStockAccuracyDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-report-stock-accuracy-desktop.webp'
import reportStockAccuracyMobileImage from '../assets/marketing/stoqr/optimized/stoqr-report-stock-accuracy-mobile.webp'
import reportStockMovementDesktopImage from '../assets/marketing/stoqr/optimized/stoqr-report-stock-movement-desktop.webp'
import reportStockMovementMobileImage from '../assets/marketing/stoqr/optimized/stoqr-report-stock-movement-mobile.webp'
import MarketingIcon from '../components/MarketingIcon.astro'
import StoqrScreenshot from '../components/StoqrScreenshot.astro'
import MarketingLayout from '../layouts/MarketingLayout.astro'

const features = [
  {
    title: 'Dashboard',
    active: 'Dashboard',
    eyebrow: 'Know what needs attention now.',
    description: 'Watch inventory value, stock health, pending purchase orders, and critical alerts from one calm command center.',
    icon: 'layout',
    tone: 'warm',
    screenshot: {
      desktopSrc: dashboardDesktopImage,
      mobileSrc: dashboardMobileImage,
      alt: 'Open-StoQR dashboard showing stock health, inventory value, alerts, and purchase order status.',
      caption: 'Stock health, inventory value, purchase orders, and alerts in one operating view.',
    },
    bullets: ['See urgent stock risk before it becomes a stockout.', 'Track value, movement, and purchase order pressure together.', 'Give managers one place to start the day.'],
  },
  {
    title: 'Inventory',
    active: 'Inventory',
    eyebrow: 'Every item, folder, SKU, and quantity in reach.',
    description: 'Browse products, locations, low-stock states, and custom fields without leaving the working surface.',
    icon: 'package',
    tone: 'plain',
    screenshot: {
      desktopSrc: inventoryDesktopImage,
      mobileSrc: inventoryMobileImage,
      alt: 'Open-StoQR inventory screen showing product folders, quantities, SKU details, and stock status.',
      caption: 'Browse products, locations, quantities, SKU details, and low-stock states without losing context.',
    },
    bullets: ['Organize products by location, bin, type, or custom workflow.', 'Filter low-stock and out-of-stock items without hunting.', 'Keep SKU, quantity, and status details visible at once.'],
  },
  {
    title: 'Label Studio',
    active: 'Label Studio',
    eyebrow: 'Print labels that match the way you work.',
    description: 'Build product, shelf, and batch label templates with variable fields, SKU data, and barcode output.',
    icon: 'printer',
    tone: 'warm',
    screenshot: {
      desktopSrc: labelEditorDesktopImage,
      mobileSrc: labelEditorMobileImage,
      alt: 'Open-StoQR label editor showing barcode label layout controls and product data fields.',
      caption: 'Design reusable barcode and QR labels with product fields, layout controls, and print-ready output.',
    },
    bullets: ['Create reusable templates for products, shelves, and batches.', 'Include barcode, SKU, location, and quantity fields.', 'Prepare consistent labels for batch printing.'],
  },
  {
    title: 'Label Print',
    active: 'Label Studio',
    eyebrow: 'Send accurate labels to the floor.',
    description: 'Prepare print runs for products, shelves, and batches with the right template, quantity, and barcode data before work moves physical.',
    icon: 'printer',
    tone: 'plain',
    screenshot: {
      desktopSrc: labelPrintDesktopImage,
      mobileSrc: labelPrintMobileImage,
      alt: 'Open-StoQR label print screen showing product labels prepared for printing.',
      caption: 'Prepare consistent product, shelf, and batch labels for fast physical workflows.',
    },
    bullets: ['Preview labels before they reach the printer.', 'Batch product and shelf labels for warehouse work.', 'Keep physical labels aligned with live inventory data.'],
  },
  {
    title: 'Reports',
    active: 'Reports',
    eyebrow: 'Turn stock movement into decisions.',
    description: 'Review valuation, velocity, shrinkage, reorder candidates, supplier movement, and exports.',
    icon: 'clipboard',
    tone: 'plain',
    screenshot: {
      desktopSrc: reportInventoryDesktopImage,
      mobileSrc: reportInventoryMobileImage,
      alt: 'Open-StoQR inventory report showing stock status, values, and report totals.',
      caption: 'Review inventory value, stock status, and operational totals without rebuilding spreadsheets.',
    },
    bullets: ['Review valuation and movement without rebuilding sheets.', 'Find slow-moving and reorder candidate products.', 'Export operational views when finance or suppliers need them.'],
  },
  {
    title: 'Stock Movement Report',
    active: 'Reports',
    eyebrow: 'Understand every stock change.',
    description: 'Track inbound, outbound, adjusted, and transferred inventory activity so movement history stays visible across teams and locations.',
    icon: 'trending',
    tone: 'cool',
    screenshot: {
      desktopSrc: reportStockMovementDesktopImage,
      mobileSrc: reportStockMovementMobileImage,
      alt: 'Open-StoQR stock movement report showing inbound, outbound, and adjusted inventory activity.',
      caption: 'Track inbound, outbound, and adjusted stock movement across the business.',
    },
    bullets: ['Separate receiving, usage, transfers, and corrections.', 'Find unusual movement before it becomes a reconciliation issue.', 'Give operators and managers the same movement trail.'],
  },
  {
    title: 'Stock Accuracy Report',
    active: 'Reports',
    eyebrow: 'Catch count drift early.',
    description: 'Review discrepancies, shrinkage signals, and count status so the system record stays close to what is actually on the shelf.',
    icon: 'file-chart',
    tone: 'plain',
    screenshot: {
      desktopSrc: reportStockAccuracyDesktopImage,
      mobileSrc: reportStockAccuracyMobileImage,
      alt: 'Open-StoQR stock accuracy report showing discrepancies and inventory count status.',
      caption: 'Spot discrepancies, shrinkage, and count issues before they become reporting problems.',
    },
    bullets: ['Surface count discrepancies by product and location.', 'Prioritize checks where accuracy risk is highest.', 'Keep audit work connected to live inventory records.'],
  },
  {
    title: 'Purchasing Report',
    active: 'Reports',
    eyebrow: 'See replenishment pressure clearly.',
    description: 'Understand supplier activity, purchase order trends, and buying pressure before stock gaps reach the floor.',
    icon: 'clipboard',
    tone: 'warm',
    screenshot: {
      desktopSrc: reportPurchasingDesktopImage,
      mobileSrc: reportPurchasingMobileImage,
      alt: 'Open-StoQR purchasing report showing supplier activity and replenishment trends.',
      caption: 'Understand purchasing pressure, supplier activity, and replenishment trends.',
    },
    bullets: ['Track open purchase order volume and supplier activity.', 'Compare replenishment demand against stock status.', 'Give purchasing teams a focused operational report.'],
  },
  {
    title: 'Procurement',
    active: 'Procurement',
    eyebrow: 'Replenishment without the scramble.',
    description: 'Create purchase orders, manage suppliers, follow receiving workflows, and spot delayed replenishment.',
    icon: 'shopping',
    tone: 'cool',
    screenshot: {
      desktopSrc: procurementPurchaseOrdersDesktopImage,
      mobileSrc: procurementPurchaseOrdersMobileImage,
      alt: 'Open-StoQR purchase orders screen showing procurement order status and receiving workflow details.',
      caption: 'Create and track purchase orders from request through receiving.',
    },
    bullets: ['Track supplier, approval, receiving, and delay status.', 'Connect reorder pressure to purchase order workflows.', 'Keep inbound replenishment visible to the inventory team.'],
  },
  {
    title: 'Supplier Management',
    active: 'Procurement',
    eyebrow: 'Keep supplier context beside purchasing.',
    description: 'Manage supplier records, contacts, terms, and procurement relationships without disconnecting them from inventory demand.',
    icon: 'users',
    tone: 'plain',
    screenshot: {
      desktopSrc: procurementSuppliersDesktopImage,
      mobileSrc: procurementSuppliersMobileImage,
      alt: 'Open-StoQR suppliers screen showing supplier records, contact details, and procurement relationships.',
      caption: 'Manage supplier records, contact details, and procurement relationships in one place.',
    },
    bullets: ['Store supplier contact and ordering context in one roster.', 'Connect purchasing work to the right supplier records.', 'Keep vendor details available during replenishment decisions.'],
  },
  {
    title: 'Organisation RBAC',
    active: 'Organisations',
    eyebrow: 'Access control that stays understandable.',
    description: 'Invite members, assign roles, control operational permissions, and keep team access clear.',
    icon: 'shield',
    tone: 'plain',
    screenshot: {
      desktopSrc: organisationTeamsDesktopImage,
      mobileSrc: organisationTeamsMobileImage,
      alt: 'Open-StoQR organization teams screen showing members, roles, and access management.',
      caption: 'Invite team members and organize access around the way the operation actually works.',
    },
    bullets: ['Invite members with roles that match their work.', 'Restrict sensitive settings and procurement controls.', 'Keep permissions readable as the organization grows.'],
  },
  {
    title: 'Role Editor',
    active: 'Organisations',
    eyebrow: 'Shape roles around real work.',
    description: 'Edit role permissions for inventory, procurement, reports, labels, and administration with clear controls.',
    icon: 'key',
    tone: 'cool',
    screenshot: {
      desktopSrc: organisationRoleEditorDesktopImage,
      mobileSrc: organisationRoleEditorMobileImage,
      alt: 'Open-StoQR role editor showing permission controls for inventory, procurement, reports, labels, and administration.',
      caption: 'Control permissions for inventory, procurement, reports, labels, and administration.',
    },
    bullets: ['Adjust permissions by workflow instead of buried settings.', 'Keep administrative access separate from daily inventory work.', 'Review role scope before assigning it to team members.'],
  },
] as const

const transparentPixel = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw=='
const screenshotFeatures = features.flatMap((feature) => (feature.screenshot ? [{ ...feature, screenshot: feature.screenshot }] : []))
---

<MarketingLayout landingContext="stoqr" title="Open-StoQR | Inventory Operations">
  <section class="relative mx-auto flex min-h-[92vh] max-w-7xl flex-col items-center justify-center px-6 pb-16 pt-[calc(6rem+4rem)] text-center">
    <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-[color:color-mix(in_srgb,var(--color-secondary)_18%,transparent)] bg-white text-[var(--color-secondary)]">
      <MarketingIcon name="boxes" class="h-6 w-6" />
    </span>
    <h1 class="mt-7 text-6xl font-semibold leading-none text-[var(--color-heading)] md:text-8xl">Open-StoQR</h1>
    <p class="mt-5 text-2xl font-semibold text-[color:color-mix(in_srgb,var(--color-secondary)_82%,#8e5f2b)] md:text-3xl">Physical inventory, digitally mastered.</p>
    <p class="mx-auto mt-6 max-w-4xl text-lg leading-8 text-[var(--color-body)] md:text-xl">
      Track, scan, procure, report, and govern inventory operations from an open source product suite your team can inspect before they deploy it.
    </p>
    <a href="#stoqr-dashboard" class="mt-9 inline-flex items-center justify-center rounded-full border border-[var(--opense-shell-border-strong)] bg-white px-7 py-3 text-sm font-semibold text-[var(--color-heading)] transition-transform duration-200 hover:-translate-y-0.5">See the UI</a>
  </section>

  <section class="stoqr-scroll-showcase relative border-t border-[color:var(--opense-shell-border)] bg-white px-6 py-20 md:py-28" data-stoqr-scroll-showcase>
    <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16">
      <div class="stoqr-scroll-showcase__copy">
        {screenshotFeatures.map((feature) => {
          const stepId = `stoqr-${feature.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
          return (
            <article id={stepId} data-stoqr-step={stepId} data-testid="product-feature-preview" class="stoqr-scroll-showcase__step">
              <div class="flex items-center gap-4">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-[color:color-mix(in_srgb,var(--color-secondary)_16%,transparent)] bg-white text-[var(--color-secondary)]">
                  <MarketingIcon name={feature.icon} class="h-5 w-5" />
                </span>
                <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-secondary)]">{feature.eyebrow}</p>
              </div>
              <h2 class="mt-7 text-4xl font-semibold leading-[1.03] text-[var(--color-heading)] md:text-6xl">{feature.title}</h2>
              <p class="mt-5 text-lg leading-8 text-[var(--color-body)] md:text-xl">{feature.description}</p>
              <ul class="mt-10 space-y-6">
                {feature.bullets.map((bullet) => (
                  <li class="flex gap-4 text-left text-base leading-7 text-[var(--color-foreground)]">
                    <span class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[var(--color-secondary)]">
                      <MarketingIcon name="check-circle" class="h-5 w-5" />
                    </span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-10 lg:hidden">
                <StoqrScreenshot src={feature.screenshot.mobileSrc} alt={feature.screenshot.alt} caption={feature.screenshot.caption} />
              </div>
            </article>
          )
        })}
      </div>

      <div class="stoqr-scroll-showcase__visual hidden lg:block" aria-hidden="true">
        <div class="stoqr-scroll-showcase__sticky">
          {screenshotFeatures.map((feature, index) => {
            const stepId = `stoqr-${feature.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`
            return (
              <figure class:list={['stoqr-scroll-showcase__figure', index === 0 ? 'is-active' : '']} data-stoqr-image={stepId}>
                <div class="stoqr-scroll-showcase__media">
                  <img
                    src={index === 0 ? feature.screenshot.desktopSrc.src : transparentPixel}
                    data-stoqr-lazy-image
                    data-src={feature.screenshot.desktopSrc.src}
                    data-loaded={index === 0 ? 'true' : undefined}
                    alt=""
                    width={feature.screenshot.desktopSrc.width}
                    height={feature.screenshot.desktopSrc.height}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                  />
                </div>
                <figcaption>{feature.screenshot.caption}</figcaption>
              </figure>
            )
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="relative border-t border-[color:var(--opense-shell-border)] bg-white px-6 py-24 text-center">
    <h2 class="mx-auto max-w-4xl text-5xl font-semibold text-[var(--color-heading)] md:text-7xl">Ready to organize your assets?</h2>
    <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-[var(--color-body)]">Upgrade your team's efficiency with Open-StoQR. Open source, customizable, and easy to deploy for your organization.</p>
  </section>

  <script is:inline data-astro-rerun>
    ;(() => {
      const cleanupKey = '__stoqrScrollShowcaseCleanup'
      const showcase = document.querySelector('[data-stoqr-scroll-showcase]')
      const previousCleanup = showcase?.[cleanupKey]
      if (typeof previousCleanup === 'function') previousCleanup()

      const steps = Array.from(showcase?.querySelectorAll('[data-stoqr-step]') ?? [])
      const images = Array.from(showcase?.querySelectorAll('[data-stoqr-image]') ?? [])
      const observers = []

      const loadFigureImage = (figure) => {
        const image = figure?.querySelector('[data-stoqr-lazy-image]')
        if (!image || image.dataset.loaded === 'true') return

        const src = image.dataset.src
        if (src) image.setAttribute('src', src)
        image.dataset.loaded = 'true'
      }

      const loadAroundStep = (id) => {
        const activeIndex = images.findIndex((image) => image.getAttribute('data-stoqr-image') === id)
        if (activeIndex < 0) return

        ;[activeIndex - 1, activeIndex, activeIndex + 1].forEach((index) => {
          loadFigureImage(images[index])
        })
      }

      const setActiveStep = (id) => {
        loadAroundStep(id)
        images.forEach((image) => {
          image.classList.toggle('is-active', image.getAttribute('data-stoqr-image') === id)
        })
        steps.forEach((step) => {
          step.classList.toggle('is-active', step.getAttribute('data-stoqr-step') === id)
        })
      }

      const firstStepId = steps[0]?.getAttribute('data-stoqr-step')
      if (!firstStepId) return

      setActiveStep(firstStepId)

      if ('IntersectionObserver' in window) {
        const activeObserver = new IntersectionObserver(
          (entries) => {
            const active = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0]
            const id = active?.target.getAttribute('data-stoqr-step')
            if (id) setActiveStep(id)
          },
          {
            rootMargin: '-24% 0px -36% 0px',
            threshold: [0.2, 0.35, 0.5, 0.65, 0.8],
          },
        )

        const preloadObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const id = entry.target.getAttribute('data-stoqr-step')
              if (entry.isIntersecting && id) loadAroundStep(id)
            })
          },
          {
            rootMargin: '80% 0px',
            threshold: 0.01,
          },
        )

        steps.forEach((step) => {
          activeObserver.observe(step)
          preloadObserver.observe(step)
        })
        observers.push(activeObserver, preloadObserver)
      } else {
        images.forEach(loadFigureImage)
      }

      showcase[cleanupKey] = () => {
        observers.forEach((observer) => observer.disconnect())
        delete showcase[cleanupKey]
      }
    })()
  </script>

  <style>
    .stoqr-scroll-showcase__step {
      display: grid;
      align-content: center;
      min-height: 72vh;
      padding-block: 3.5rem;
      opacity: 0.72;
      transition:
        opacity 220ms ease,
        transform 220ms ease;
    }

    .stoqr-scroll-showcase__step.is-active {
      opacity: 1;
    }

    .stoqr-scroll-showcase__visual {
      position: relative;
      min-width: 0;
    }

    .stoqr-scroll-showcase__sticky {
      position: sticky;
      top: 7rem;
      height: min(45rem, calc(100vh - 9rem));
    }

    .stoqr-scroll-showcase__figure {
      position: absolute;
      inset: 0;
      display: grid;
      align-content: center;
      gap: 1rem;
      margin: 0;
      opacity: 0;
      pointer-events: none;
      transition: opacity 260ms ease;
    }

    .stoqr-scroll-showcase__figure.is-active {
      opacity: 1;
    }

    .stoqr-scroll-showcase__media {
      overflow: hidden;
    }

    .stoqr-scroll-showcase__media img {
      display: block;
      width: 100%;
      height: auto;
    }

    .stoqr-scroll-showcase__figure figcaption {
      max-width: 42rem;
      color: var(--color-body);
      font-size: 0.95rem;
      line-height: 1.6;
    }

    @media (max-width: 1023px) {
      .stoqr-scroll-showcase__step {
        min-height: 0;
        padding-block: 3rem;
        opacity: 1;
      }
    }
  </style>
</MarketingLayout>
