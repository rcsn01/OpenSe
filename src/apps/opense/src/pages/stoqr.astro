---
import { ArrowRight, BellRing, Boxes, CheckCircle2, ClipboardList, LayoutDashboard, PackageSearch, Printer, QrCode, ShieldCheck, ShoppingCart } from 'lucide-astro'
import StoqrPreview from '../components/StoqrPreview.astro'
import MarketingLayout from '../layouts/MarketingLayout.astro'
import { buildNavbarGetStartedPath } from '../lib/authRedirect'

const ctaHref = buildNavbarGetStartedPath('stoqr')
const features = [
  {
    title: 'Dashboard',
    active: 'Dashboard',
    eyebrow: 'Know what needs attention now.',
    description: 'Watch inventory value, stock health, pending purchase orders, and critical alerts from one calm command center.',
    icon: LayoutDashboard,
    tone: 'warm',
    bullets: ['See urgent stock risk before it becomes a stockout.', 'Track value, movement, and purchase order pressure together.', 'Give managers one place to start the day.'],
  },
  {
    title: 'Inventory',
    active: 'Inventory',
    eyebrow: 'Every item, folder, SKU, and quantity in reach.',
    description: 'Browse products, locations, low-stock states, and custom fields without leaving the working surface.',
    icon: PackageSearch,
    tone: 'plain',
    bullets: ['Organize products by location, bin, type, or custom workflow.', 'Filter low-stock and out-of-stock items without hunting.', 'Keep SKU, quantity, and status details visible at once.'],
  },
  {
    title: 'Scanner',
    active: 'Scanner',
    eyebrow: 'Move faster on the floor.',
    description: 'Scan barcode and QR labels from the browser, match the right product instantly, then adjust stock.',
    icon: QrCode,
    tone: 'cool',
    bullets: ['Use the camera scanner without installing a native app.', 'Match the scanned item to its product record immediately.', 'Adjust stock from the same scan action surface.'],
  },
  {
    title: 'Label Studio',
    active: 'Label Studio',
    eyebrow: 'Print labels that match the way you work.',
    description: 'Build product, shelf, and batch label templates with variable fields, SKU data, and barcode output.',
    icon: Printer,
    tone: 'warm',
    bullets: ['Create reusable templates for products, shelves, and batches.', 'Include barcode, SKU, location, and quantity fields.', 'Prepare consistent labels for batch printing.'],
  },
  {
    title: 'Reports',
    active: 'Reports',
    eyebrow: 'Turn stock movement into decisions.',
    description: 'Review valuation, velocity, shrinkage, reorder candidates, supplier movement, and exports.',
    icon: ClipboardList,
    tone: 'plain',
    bullets: ['Review valuation and movement without rebuilding sheets.', 'Find slow-moving and reorder candidate products.', 'Export operational views when finance or suppliers need them.'],
  },
  {
    title: 'Procurement',
    active: 'Procurement',
    eyebrow: 'Replenishment without the scramble.',
    description: 'Create purchase orders, manage suppliers, follow receiving workflows, and spot delayed replenishment.',
    icon: ShoppingCart,
    tone: 'cool',
    bullets: ['Track supplier, approval, receiving, and delay status.', 'Connect reorder pressure to purchase order workflows.', 'Keep inbound replenishment visible to the inventory team.'],
  },
  {
    title: 'Alerts',
    active: 'Alerts',
    eyebrow: 'Let the system raise its hand first.',
    description: 'Configure low-stock, expiry, reorder, delivery, and connector notifications.',
    icon: BellRing,
    tone: 'warm',
    bullets: ['Trigger alerts for low stock, expiry, delivery, and connectors.', 'Separate critical events from ordinary operational noise.', 'Route the right issue to the right team sooner.'],
  },
  {
    title: 'Organisation RBAC',
    active: 'Organisations',
    eyebrow: 'Access control that stays understandable.',
    description: 'Invite members, assign roles, control operational permissions, and keep team access clear.',
    icon: ShieldCheck,
    tone: 'plain',
    bullets: ['Invite members with roles that match their work.', 'Restrict sensitive settings and procurement controls.', 'Keep permissions readable as the organization grows.'],
  },
] as const

const toneBackground = {
  warm: 'linear-gradient(180deg,color-mix(in srgb,var(--color-warning-light) 36%,white) 0%,color-mix(in srgb,var(--color-background) 86%,white) 100%)',
  cool: 'linear-gradient(180deg,color-mix(in srgb,var(--color-info-light) 34%,white) 0%,color-mix(in srgb,var(--color-background) 88%,white) 100%)',
  plain: 'linear-gradient(180deg,white 0%,color-mix(in srgb,var(--color-background) 88%,white) 100%)',
}
---

<MarketingLayout landingContext="stoqr" title="Open-StoQR | Inventory Operations">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 bg-[var(--color-background)]"></div>
    <div class="absolute left-[-10rem] top-[-4rem] h-[28rem] w-[28rem] rounded-full blur-3xl" style="background-color:color-mix(in srgb,var(--color-warning-light) 52%,white)"></div>
    <div class="absolute right-[-9rem] top-[22rem] h-[22rem] w-[22rem] rounded-full blur-3xl" style="background-color:color-mix(in srgb,var(--color-info-light) 34%,white)"></div>
  </div>

  <section class="relative mx-auto flex min-h-[92vh] max-w-7xl flex-col items-center justify-center px-6 pb-16 pt-[calc(6rem+4rem)] text-center">
    <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-[color:color-mix(in_srgb,var(--color-secondary)_18%,transparent)] bg-[color:color-mix(in_srgb,var(--color-warning-light)_48%,white)] text-[var(--color-secondary)]">
      <Boxes class="h-6 w-6" />
    </span>
    <h1 class="mt-7 text-6xl font-semibold leading-none text-[var(--color-heading)] md:text-8xl">Open-StoQR</h1>
    <p class="mt-5 text-2xl font-semibold text-[color:color-mix(in_srgb,var(--color-secondary)_82%,#8e5f2b)] md:text-3xl">Physical inventory, digitally mastered.</p>
    <p class="mx-auto mt-6 max-w-4xl text-lg leading-8 text-[var(--color-body)] md:text-xl">
      Track, scan, procure, report, and govern inventory operations from an open source product suite your team can inspect before they deploy it.
    </p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
      <a href={ctaHref} data-testid="stoqr-deploy-open-stoqr" class="inline-flex min-w-44 items-center justify-center whitespace-nowrap rounded-full bg-[var(--color-foreground)] px-7 py-3 text-sm font-semibold text-white transition-transform duration-200 hover:-translate-y-0.5">Deploy Open-StoQR</a>
      <a href="#stoqr-dashboard" class="inline-flex items-center justify-center rounded-full border border-[var(--opense-shell-border-strong)] bg-white/72 px-7 py-3 text-sm font-semibold text-[var(--color-heading)] transition-transform duration-200 hover:-translate-y-0.5">See the UI</a>
    </div>
  </section>

  {features.map((feature, index) => {
    const Icon = feature.icon
    return (
      <section id={`stoqr-${feature.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`} class="relative overflow-hidden border-t border-[color:var(--opense-shell-border)] px-6 py-20 md:py-28" style={`background:${toneBackground[feature.tone]}`}>
        <div class={`mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:gap-16 ${index % 2 === 1 ? 'lg:grid-cols-[1.18fr_0.82fr]' : ''}`}>
          <div class={`max-w-xl ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
            <div class="flex items-center gap-4">
              <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-[color:color-mix(in_srgb,var(--color-secondary)_16%,transparent)] bg-white/72 text-[var(--color-secondary)]">
                <Icon class="h-5 w-5" />
              </span>
              <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[var(--color-secondary)]">{feature.eyebrow}</p>
            </div>
            <h2 class="mt-7 text-4xl font-semibold leading-[1.03] text-[var(--color-heading)] md:text-6xl">{feature.title}</h2>
            <p class="mt-5 text-lg leading-8 text-[var(--color-body)] md:text-xl">{feature.description}</p>
            <ul class="mt-10 space-y-6">
              {feature.bullets.map((bullet) => (
                <li class="flex gap-4 text-left text-base leading-7 text-[var(--color-foreground)]">
                  <span class="mt-1 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-[var(--color-secondary)]">
                    <CheckCircle2 class="h-5 w-5" />
                  </span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <div class="mt-10 flex flex-wrap items-center gap-5">
              <a href={ctaHref} class="inline-flex min-w-40 items-center justify-center whitespace-nowrap rounded-full bg-[var(--color-foreground)] px-6 py-3 text-sm font-semibold text-white transition-transform duration-200 hover:-translate-y-0.5">Deploy Open-StoQR</a>
              <a href="#stoqr-reports" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--color-secondary)]">
                See all workflows
                <ArrowRight class="h-4 w-4" />
              </a>
            </div>
          </div>
          <div data-testid="product-feature-preview" aria-hidden="true" class={`stoqr-showcase-preview w-full ${index % 2 === 1 ? 'is-left' : 'is-right'}`}>
            <StoqrPreview active={feature.active} eyebrow={feature.eyebrow} title={feature.title} />
          </div>
        </div>
      </section>
    )
  })}

  <section class="relative border-t border-[color:var(--opense-shell-border)] bg-[var(--color-foreground)] px-6 py-24 text-center text-white">
    <h2 class="mx-auto max-w-4xl text-5xl font-semibold md:text-7xl">Ready to organize your assets?</h2>
    <p class="mx-auto mt-6 max-w-3xl text-lg leading-8 text-white/76">Upgrade your team's efficiency with Open-StoQR. Open source, customizable, and easy to deploy for your organization.</p>
    <a href={ctaHref} class="mt-9 inline-flex min-w-44 items-center justify-center whitespace-nowrap rounded-full bg-white px-7 py-3 text-sm font-semibold text-[var(--color-heading)] transition-transform duration-200 hover:-translate-y-0.5">Deploy Open-StoQR</a>
  </section>
</MarketingLayout>

<script>
  import { setActiveLandingContext } from '../lib/authRedirect'
  setActiveLandingContext('stoqr')
</script>
