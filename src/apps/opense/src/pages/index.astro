---
import ArchitectureAnimator from '../components/ArchitectureAnimator.astro'
import MarketingLayout from '../layouts/MarketingLayout.astro'
import desktopUi from '../assets/platform/desktop-ui.png'
import phoneUi from '../assets/platform/phone-ui.png'
import webUi from '../assets/platform/web-ui.png'
---

<MarketingLayout landingContext="opense" title="OpenSe | Open Source SaaS Stack" includeFooter={true}>
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 bg-[var(--color-background)]"></div>
    <div class="absolute inset-x-0 top-0 h-[26rem]" style="background:linear-gradient(180deg,color-mix(in srgb,var(--color-primary-light) 42%,var(--color-background)) 0%,transparent 100%)"></div>
  </div>

  <section class="relative mx-auto max-w-5xl px-6 pb-8 pt-[calc(6rem+4.5rem)] text-center">
    <h1 class="mx-auto max-w-4xl text-5xl font-semibold leading-[0.94] text-[var(--color-heading)] sm:text-6xl lg:text-[5.25rem]">
      Open Source<br />
      <span style="color:color-mix(in srgb,var(--color-primary-hover) 82%,var(--color-heading))">Free,</span>
      <span style="color:#8a5b2f">Forever</span>
    </h1>
    <p class="mx-auto mt-8 max-w-3xl text-lg leading-8 text-[var(--color-body)] md:text-xl">
      Own the tools you use, own the data you use.
    </p>
  </section>

  <section class="relative mx-auto max-w-6xl px-6 py-12">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
      <div>
        <h2 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight text-[var(--color-heading)] md:text-5xl">
          Multi-Platform. Browser, desktop, or phone.
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--color-body)]">
          Use OpenSe products anytime, anywhere, on any device.
        </p>
      </div>
    </div>

    <div class="mt-12 overflow-visible">
      <div class="platform-stack relative isolate mx-auto min-h-[29rem] w-full max-w-[56rem] sm:min-h-[38rem] lg:min-h-[48rem]" data-platform-stack>
        <figure class="absolute left-0 top-0 w-[93%] max-w-[52rem] overflow-hidden rounded-lg" data-platform-shot="web">
          <img
            src={webUi.src}
            width={webUi.width}
            height={webUi.height}
            alt="OpenSe web inventory interface showing product rows, filters, and folder navigation"
            class="block h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="absolute left-0 top-[8rem] w-[93%] max-w-[52rem] overflow-hidden rounded-lg sm:top-[10rem] lg:top-[11.5rem]" data-platform-shot="desktop">
          <img
            src={desktopUi.src}
            width={desktopUi.width}
            height={desktopUi.height}
            alt="OpenSe desktop inventory interface in a native desktop window"
            class="block h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="absolute left-[68%] top-16 w-[44%] min-w-[11rem] max-w-[18rem] overflow-hidden rounded-lg sm:top-20 lg:top-28" data-platform-shot="phone">
          <img
            src={phoneUi.src}
            width={phoneUi.width}
            height={phoneUi.height}
            alt="OpenSe mobile inventory interface on a phone"
            class="block h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="absolute left-0 top-0 w-[93%] max-w-[52rem] overflow-hidden rounded-lg" data-platform-overlay="web" aria-hidden="true">
          <img
            src={webUi.src}
            width={webUi.width}
            height={webUi.height}
            alt=""
            class="block h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="absolute left-0 top-[8rem] w-[93%] max-w-[52rem] overflow-hidden rounded-lg sm:top-[10rem] lg:top-[11.5rem]" data-platform-overlay="desktop" aria-hidden="true">
          <img
            src={desktopUi.src}
            width={desktopUi.width}
            height={desktopUi.height}
            alt=""
            class="block h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="absolute left-[68%] top-16 w-[44%] min-w-[11rem] max-w-[18rem] overflow-hidden rounded-lg sm:top-20 lg:top-28" data-platform-overlay="phone" aria-hidden="true">
          <img
            src={phoneUi.src}
            width={phoneUi.width}
            height={phoneUi.height}
            alt=""
            class="block h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="absolute z-50 grid grid-cols-2 grid-rows-2" data-platform-hover-grid aria-hidden="true">
          <div data-platform-hover="web"></div>
          <div data-platform-hover="phone"></div>
          <div data-platform-hover="desktop"></div>
          <div data-platform-hover="phone"></div>
        </div>
      </div>
    </div>
  </section>

  <section class="relative mx-auto max-w-6xl px-6 pb-4 pt-12">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
      <div>
        <h2 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight text-[var(--color-heading)] md:text-5xl">
          Own Your Infrastructure
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-8 text-[var(--color-body)]">
          OpenSe lets you choose <strong style="color:color-mix(in srgb,var(--color-primary-hover) 82%,var(--color-heading))">where</strong> and <strong style="color:#8a5b2f">how</strong> you want to deploy, and keep your data.
        </p>
      </div>
    </div>

    <div class="mt-10">
      <ArchitectureAnimator />
    </div>
  </section>
</MarketingLayout>

<style>
  .platform-stack [data-platform-shot] {
    opacity: 1;
    transform: scale(1);
    transform-origin: center;
    transition: transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .platform-stack [data-platform-shot='web'] {
    z-index: 20;
  }

  .platform-stack [data-platform-shot='desktop'] {
    z-index: 10;
  }

  .platform-stack [data-platform-shot='phone'] {
    z-index: 30;
  }

  .platform-stack [data-platform-overlay] {
    z-index: 40;
    pointer-events: none;
    opacity: 0;
    transform: scale(0.985);
    transform-origin: center;
    transition:
      opacity 360ms ease,
      transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .platform-stack:has([data-platform-hover='web']:hover) [data-platform-overlay='web'],
  .platform-stack:has([data-platform-hover='desktop']:hover) [data-platform-overlay='desktop'],
  .platform-stack:has([data-platform-hover='phone']:hover) [data-platform-overlay='phone'],
  .platform-stack[data-active-platform='web'] [data-platform-overlay='web'],
  .platform-stack[data-active-platform='desktop'] [data-platform-overlay='desktop'],
  .platform-stack[data-active-platform='phone'] [data-platform-overlay='phone'] {
    opacity: 1;
    transform: scale(1.035);
  }
</style>

<script>
  const setupPlatformStacks = () => {
    document.querySelectorAll<HTMLElement>('[data-platform-stack]').forEach((stack) => {
      if (stack.dataset.platformStackReady === 'true') {
        return
      }

      stack.dataset.platformStackReady = 'true'

      const hoverGrid = stack.querySelector<HTMLElement>('[data-platform-hover-grid]')
      const updateHoverGrid = () => {
        if (!hoverGrid) {
          return
        }

        const stackRect = stack.getBoundingClientRect()
        const shotRects = [...stack.querySelectorAll<HTMLElement>('[data-platform-shot]')].map((shot) =>
          shot.getBoundingClientRect()
        )

        if (!shotRects.length) {
          return
        }

        const left = Math.min(...shotRects.map((rect) => rect.left)) - stackRect.left
        const top = Math.min(...shotRects.map((rect) => rect.top)) - stackRect.top
        const right = Math.max(...shotRects.map((rect) => rect.right)) - stackRect.left
        const bottom = Math.max(...shotRects.map((rect) => rect.bottom)) - stackRect.top

        hoverGrid.style.left = `${Math.max(0, left)}px`
        hoverGrid.style.top = `${Math.max(0, top)}px`
        hoverGrid.style.width = `${Math.max(0, right - left)}px`
        hoverGrid.style.height = `${Math.max(0, bottom - top)}px`
      }

      stack.querySelectorAll<HTMLElement>('[data-platform-hover]').forEach((target) => {
        const activateTarget = () => {
          stack.dataset.activePlatform = target.dataset.platformHover ?? ''
        }

        target.addEventListener('pointerenter', activateTarget)
        target.addEventListener('mouseenter', activateTarget)
      })

      const clearTarget = () => {
        delete stack.dataset.activePlatform
      }

      stack.addEventListener('pointerleave', clearTarget)
      stack.addEventListener('mouseleave', clearTarget)

      stack.querySelectorAll('img').forEach((image) => {
        image.addEventListener('load', updateHoverGrid)
      })

      window.addEventListener('resize', updateHoverGrid)
      requestAnimationFrame(updateHoverGrid)
    })
  }

  setupPlatformStacks()
  document.addEventListener('astro:page-load', setupPlatformStacks)
</script>
