---
import ArchitectureAnimator from '../components/ArchitectureAnimator.astro'
import MarketingIcon from '../components/MarketingIcon.astro'
import MarketingLayout from '../layouts/MarketingLayout.astro'

const infrastructureHighlights = [
  {
    title: 'Postgres & Supabase',
    description: 'Robust relational data modeling utilizing PostgreSQL with Row Level Security managed by Supabase.',
    icon: 'database',
  },
  {
    title: 'Kubernetes Ready',
    description: 'Designed for container orchestration. Deploy via K8s, K3s, Docker, or Portainer environments.',
    icon: 'workflow',
  },
  {
    title: 'Monorepo Frontend',
    description: 'Turbo Repo architecture powering high-performance, modular product applications for ETL and StoQR.',
    icon: 'network',
  },
] as const
---

<MarketingLayout landingContext="opense" title="OpenSe | Open Source SaaS Stack">
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 bg-[var(--color-background)]"></div>
    <div class="absolute inset-x-0 top-0 h-[26rem]" style="background:linear-gradient(180deg,color-mix(in srgb,var(--color-primary-light) 42%,var(--color-background)) 0%,transparent 100%)"></div>
  </div>

  <section class="relative mx-auto max-w-5xl px-6 pb-8 pt-[calc(6rem+4.5rem)] text-center">
    <h1 class="mx-auto max-w-4xl text-5xl font-semibold leading-[0.94] text-[var(--color-heading)] sm:text-6xl lg:text-[5.25rem]">
      The Open Source <span style="color:color-mix(in srgb,var(--color-primary-hover) 78%,var(--color-heading))">SaaS Stack</span> for Modern Teams
    </h1>
    <p class="mx-auto mt-8 max-w-3xl text-lg leading-8 text-[var(--color-body)] md:text-xl">
      Empower your organization with enterprise-grade, privacy-first tools. Deploy Open-ETL for secure data processing and Open-StoQR for intelligent inventory management, all with zero vendor lock-in.
    </p>
  </section>

  <section class="relative mx-auto max-w-6xl px-6 py-12">
    <div class="rounded-[2rem] border p-8 md:p-10" style="border-color:var(--opense-shell-border);background-color:color-mix(in srgb,var(--color-card) 80%,transparent);box-shadow:var(--opense-shell-shadow-card)">
      <div class="flex justify-center">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-full border bg-white/85 text-[var(--color-heading)]" style="border-color:var(--opense-shell-border)">
          <MarketingIcon name="command" class="h-7 w-7" />
        </span>
      </div>
      <h2 class="mt-6 text-center text-4xl font-semibold text-[var(--color-heading)] md:text-5xl">Own Your Infrastructure</h2>
      <p class="mx-auto mt-5 max-w-3xl text-center text-lg leading-8 text-[var(--color-body)]">
        OpenSe is built on an open architecture. Whether you want to use our managed cloud or deploy entirely on your own K8s/Docker infrastructure, you remain in complete control.
      </p>
      <div class="mt-10 rounded-[1.5rem] border p-5" style="border-color:var(--opense-shell-border);background-color:rgba(255,255,255,0.58)">
        <ArchitectureAnimator />
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {infrastructureHighlights.map((item) => {
          return (
            <article class="flex items-start gap-4">
              <span class="mt-1 inline-flex h-10 w-10 items-center justify-center rounded-2xl bg-white/75 text-[var(--color-primary-hover)] shadow-sm">
                <MarketingIcon name={item.icon} class="h-5 w-5" />
              </span>
              <div>
                <h3 class="text-lg font-semibold text-[var(--color-heading)]">{item.title}</h3>
                <p class="mt-2 text-sm leading-6 text-[var(--color-body)]">{item.description}</p>
              </div>
            </article>
          )
        })}
      </div>
    </div>
  </section>
</MarketingLayout>
