---
import '../index.css'
import MarketingNavbar from '../components/MarketingNavbar.astro'
import MarketingFooter from '../components/MarketingFooter.astro'

interface Props {
  title?: string
  description?: string
  landingContext?: 'opense' | 'etl' | 'stoqr'
  includeFooter?: boolean
  includeRuntimeConfig?: boolean
}

const {
  title = 'OpenSe',
  description = 'The open source SaaS stack for privacy-first data workflows and inventory operations.',
  landingContext = 'opense',
  includeFooter = true,
  includeRuntimeConfig = false,
} = Astro.props
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {includeRuntimeConfig ? <script is:inline src="/config.js"></script> : null}
  </head>
  <body data-landing-context={landingContext}>
    <div class="relative min-h-screen bg-[var(--color-background)] text-[var(--color-foreground)]">
      <MarketingNavbar landingContext={landingContext} />
      <main>
        <slot />
      </main>
      {includeFooter ? <MarketingFooter /> : null}
    </div>
  </body>
</html>
