---
import MarketingIcon from './MarketingIcon.astro'

interface Props {
  active: 'Dashboard' | 'Inventory' | 'Scanner' | 'Label Studio' | 'Reports' | 'Procurement' | 'Alerts' | 'Organisations'
  eyebrow: string
  title: string
}

const { active, eyebrow, title } = Astro.props
const menuItems = [
  { label: 'Dashboard', icon: 'layout', group: 'main' },
  { label: 'Inventory', icon: 'boxes', group: 'main' },
  { label: 'Scanner', icon: 'scan', group: 'main' },
  { label: 'Label Studio', icon: 'printer', group: 'main' },
  { label: 'Reports', icon: 'file', group: 'main' },
  { label: 'Procurement', icon: 'shopping', group: 'main' },
  { label: 'Alerts', icon: 'bell', group: 'configuration' },
  { label: 'Organisations', icon: 'building', group: 'configuration' },
] as const

const rows = {
  Dashboard: [
    ['Total value', '$482k', '+8.4%'],
    ['Items', '12,840', '324 low'],
    ['Pending POs', '18', '6 inbound'],
  ],
  Inventory: [
    ['PCR tubes', 'PCR Consumables', '0 / 10'],
    ['Nuclease Free Water', 'PCR Consumables', '24 / 9'],
    ['3% Bleach, 5L', 'Safety', '0 / 13'],
  ],
  Scanner: [
    ['Camera ready', 'QR detected', 'Matched'],
    ['LAB-188', 'Cold room B2', '+12 stock'],
    ['Batch label', 'Valid', 'Saved'],
  ],
  'Label Studio': [
    ['Product label', '62mm', 'Active'],
    ['Shelf tag', '48mm', 'Queued'],
    ['Batch label', '96mm', 'Ready'],
  ],
  Reports: [
    ['Valuation', '$482k', '+12%'],
    ['Velocity', 'Fast movers', '18'],
    ['Exports', 'Monthly CSV', 'Ready'],
  ],
  Procurement: [
    ['PO-1042', 'BioSupply Co', 'Receiving'],
    ['PO-1041', 'LabWare Direct', 'Approved'],
    ['PO-1038', 'ColdChain AU', 'Delayed'],
  ],
  Alerts: [
    ['Cold room probe offline', 'Critical', 'Now'],
    ['PPE gloves below reorder', 'High', 'Today'],
    ['Batch B-24 expires soon', 'Medium', '4 days'],
  ],
  Organisations: [
    ['Ava Chen', 'Admin', 'Full'],
    ['Noah King', 'Manager', 'Ops'],
    ['Mia Patel', 'Scanner', 'Floor'],
  ],
}[active]
---

<div class="stoqr-preview-frame" data-testid="stoqr-feature-preview" aria-hidden="true">
  <div class="stoqr-preview-shell">
    <aside class="stoqr-preview-nav">
      <div class="stoqr-preview-brand">
        <span class="stoqr-preview-brand-mark"></span>
        <span>
          <strong>Open StoQR</strong>
          <small>v1.0</small>
        </span>
      </div>
      {(['main', 'configuration'] as const).map((group) => (
        <div class="stoqr-preview-menu">
          <p class="stoqr-preview-menu-heading">{group}</p>
          {menuItems.filter((item) => item.group === group).map((item) => {
            return (
              <span class:list={[item.label === active ? 'is-active' : '']}>
                <MarketingIcon name={item.icon} class="stoqr-preview-nav-icon" />
                {item.label}
              </span>
            )
          })}
        </div>
      ))}
    </aside>
    <main class="stoqr-preview-main">
      <div class="stoqr-preview-topbar">
        <div class="stoqr-preview-search">
          <MarketingIcon name="search" class="stoqr-preview-search-icon" />
          <span>Search items...</span>
        </div>
        <div class="stoqr-preview-user-dot">I</div>
      </div>
      <div class="stoqr-preview-page-heading">
        <div>
          <p class="stoqr-preview-eyebrow">{eyebrow}</p>
          <h3 class="stoqr-preview-title">{title}</h3>
        </div>
      </div>
      <div class="stoqr-preview-grid is-three">
        {rows.map(([label, value, meta], index) => (
          <section class="stoqr-preview-card">
            <p class="stoqr-preview-label">{label}</p>
            <p class="stoqr-preview-value">{value}</p>
            <span class:list={['stoqr-preview-pill', index === 2 ? 'is-warning' : '']}>{meta}</span>
          </section>
        ))}
      </div>
      <section class="stoqr-preview-card stoqr-preview-wide-card">
        <div class="stoqr-preview-card-header">
          <p class="stoqr-preview-card-title">{title} workflow</p>
          <span class="stoqr-preview-pill is-neutral">Live</span>
        </div>
        <div class="stoqr-preview-chart">
          {[42, 64, 55, 78, 49, 88, 72, 61].map((value) => (
            <span class="stoqr-preview-bar" style={`height:${value}%`}></span>
          ))}
        </div>
      </section>
    </main>
  </div>
</div>
