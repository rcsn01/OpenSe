---
import { buildNavbarGetStartedPath, type LandingContext } from '../lib/authRedirect'
import MarketingIcon from './MarketingIcon.astro'

interface Props {
  landingContext: LandingContext
}

const { landingContext } = Astro.props
const getStartedHref = buildNavbarGetStartedPath(landingContext)
---

<nav
  class="opense-navbar fixed left-1/2 top-6 z-40 flex w-[90%] max-w-5xl -translate-x-1/2 items-center justify-between gap-4 rounded-full px-6 py-3 text-[var(--color-foreground)]"
>
  <a href="/" data-astro-prefetch data-testid="nav-opense-product" class="flex shrink-0 items-center gap-2 text-xl font-bold tracking-tight">
    <span class="grid h-9 w-9 place-items-center rounded-full bg-white/10">
      <MarketingIcon name="network" class="h-5 w-5" />
    </span>
    <span>OpenSe</span>
  </a>

  <div class="hidden items-center gap-8 text-sm font-medium md:flex">
    <a href="/stoqr" data-astro-prefetch data-testid="nav-open-stoqr-product" class="transition-transform duration-200 hover:-translate-y-px">Open-StoQR</a>
    <a href="/etl" data-astro-prefetch data-testid="nav-open-etl-product" class="transition-transform duration-200 hover:-translate-y-px">Open-ETL</a>
  </div>

  <div class="flex shrink-0 items-center gap-3">
    <a
      href={getStartedHref}
      data-testid="nav-get-started"
      class="opense-cta-dark group relative hidden items-center justify-center overflow-hidden rounded-full px-5 py-2 text-sm font-medium transition-transform duration-200 hover:-translate-y-px md:inline-flex"
    >
      <span class="absolute inset-0 z-0 h-full w-full translate-y-full bg-black/20 transition-transform duration-300 ease-out group-hover:translate-y-0"></span>
      <span class="relative z-10">Get Started</span>
    </a>
    <details class="mobile-nav-details md:hidden">
      <summary class="grid h-8 w-8 cursor-pointer list-none place-items-center rounded-full" aria-label="Toggle navigation">
        <MarketingIcon name="menu" class="menu-icon h-5 w-5" />
        <MarketingIcon name="x" class="close-icon h-5 w-5" />
      </summary>
      <div
        class="absolute left-0 right-0 top-full mt-3 flex flex-col gap-3 rounded-[1.5rem] p-4 text-[var(--color-foreground)]"
        style="background-color:color-mix(in srgb,var(--color-card) 92%,transparent);backdrop-filter:blur(20px);box-shadow:var(--opense-shell-shadow-card)"
      >
        <a href="/stoqr" data-astro-prefetch class="px-3 py-2 text-sm font-medium">Open-StoQR</a>
        <a href="/etl" data-astro-prefetch class="px-3 py-2 text-sm font-medium">Open-ETL</a>
        <a
          href={getStartedHref}
          data-testid="nav-get-started"
          class="opense-cta-dark inline-flex w-full justify-center rounded-full px-5 py-2 text-sm font-medium"
        >
          Get Started
        </a>
      </div>
    </details>
  </div>
</nav>
