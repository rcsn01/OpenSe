---
import singleServer from '../assets/architecture/single-server.svg?raw'
import threeServer from '../assets/architecture/three-server.svg?raw'
import threeServerWithBucket from '../assets/architecture/three-server-with-bucket.svg?raw'

const diagrams = [
  { title: 'Single Server', label: 'Simple deployment', svg: singleServer },
  { title: 'Three Server', label: 'Scale services independently', svg: threeServer },
  { title: 'Three Server + Bucket', label: 'Object storage ready', svg: threeServerWithBucket },
]
---

<div class="architecture-carousel">
  <div class="grid gap-5 lg:grid-cols-3">
    {diagrams.map((diagram) => (
      <figure class="architecture-panel overflow-hidden rounded-[1rem] bg-white/70">
        <div class="mx-auto max-w-4xl p-3 [&_svg]:h-auto [&_svg]:w-full" set:html={diagram.svg} />
        <figcaption class="px-4 pb-4 text-center">
          <strong class="text-sm text-[var(--color-heading)]">{diagram.title}</strong>
          <span class="ml-2 text-sm text-[var(--color-body)]">{diagram.label}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</div>
