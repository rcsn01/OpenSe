---
const diagramUnit = 16
const unit = (units: number) => Number((units * diagramUnit).toFixed(4))
const viewBox = (...units: number[]) => units.map((value) => unit(value)).join(' ')

const states = [
  {
    id: 'managed',
    title: 'Managed Stack',
    description: 'OpenSe and Supabase operated for you.',
    viewBox: viewBox(5, 2, 44, 18),
  },
  {
    id: 'cloud-supabase',
    title: 'Self-host in cloud',
    description: 'OpenSe in your cloud, Supabase managed separately.',
    viewBox: viewBox(5, 2, 44, 18),
  },
  {
    id: 'single-server',
    title: 'Self-host On Premise',
    description: 'OpenSe and Supabase on one on-premises server.',
    viewBox: viewBox(7, 2, 44, 18),
  },
  {
    id: 'three-server',
    title: 'Self-host High Availability',
    description: 'Load-balanced OpenSe with synced Supabase storage.',
    viewBox: viewBox(0, 0, 63, 25),
  },
] as const
---

<div
  class="architecture-animator"
  data-architecture-animator
  data-active-mode="cloud"
  data-active-state={states[0].id}
  data-states={JSON.stringify(states)}
>
  <div class="architecture-animator__layout">
    <aside class="architecture-animator__config" aria-label="Architecture configuration">
      <p class="architecture-animator__eyebrow">Configuration</p>

      <div class="architecture-animator__field">
        <p class="architecture-animator__label">Location</p>
        <div class="architecture-animator__segment" role="tablist" aria-label="Hosting location">
          <button type="button" data-architecture-mode="cloud" aria-selected="true" role="tab">Cloud</button>
          <button type="button" data-architecture-mode="on-premise" aria-selected="false" role="tab">On-Premise</button>
        </div>
      </div>

      <div class="architecture-animator__field" data-architecture-option-group="cloud">
        <p class="architecture-animator__label">Cloud setup</p>
        <div class="architecture-animator__options" role="tablist" aria-label="Cloud deployment options">
          <button type="button" data-architecture-control="0" aria-selected="true" role="tab">Official</button>
          <button type="button" data-architecture-control="1" aria-selected="false" role="tab">Self-Host</button>
        </div>
      </div>

      <div class="architecture-animator__field" data-architecture-provider-group hidden>
        <p class="architecture-animator__label">Cloud provider</p>
        <div class="architecture-animator__provider-options" role="tablist" aria-label="Self-hosted cloud provider options">
          <button type="button" data-architecture-provider="AWS" aria-selected="true" role="tab">AWS</button>
          <button type="button" data-architecture-provider="GCP" aria-selected="false" role="tab">GCP</button>
          <button type="button" data-architecture-provider="Azure" aria-selected="false" role="tab">Azure</button>
          <button type="button" data-architecture-provider="Any cloud" aria-selected="false" role="tab">Any cloud</button>
        </div>
      </div>

      <div class="architecture-animator__field" data-architecture-option-group="on-premise" hidden>
        <p class="architecture-animator__label">On-premise setup</p>
        <div class="architecture-animator__options" role="tablist" aria-label="On-premise deployment options">
          <button type="button" data-architecture-control="2" aria-selected="false" role="tab">Simple</button>
          <button type="button" data-architecture-control="3" aria-selected="false" role="tab">High Availability</button>
        </div>
      </div>

      <div class="architecture-animator__field" data-architecture-access-group hidden>
        <p class="architecture-animator__label">Access method</p>
        <div class="architecture-animator__access-options" role="tablist" aria-label="High availability access method options">
          <button type="button" data-architecture-access="Reverse Tunnel" aria-selected="true" role="tab">Reverse Tunnel</button>
          <button type="button" data-architecture-access="VPN" aria-selected="false" role="tab">VPN</button>
          <button type="button" data-architecture-access="Open Port" aria-selected="false" role="tab">Open Port</button>
          <button type="button" data-architecture-access="Direct Access" aria-selected="false" role="tab">Direct Access</button>
        </div>
      </div>

    </aside>

    <div class="architecture-animator__diagram-panel">
      <div class="architecture-animator__viewport">
        <svg
          class="architecture-animator__diagram"
          data-architecture-diagram
          viewBox={viewBox(0, 0, 63, 23)}
          preserveAspectRatio="xMidYMid meet"
          role="img"
          aria-label="OpenSe infrastructure deployment options"
        >
          <defs>
            <marker id="architecture-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
              <path d="M 0 0 L 8 4 L 0 8 z" fill="currentColor"></path>
            </marker>
          </defs>
          <g data-architecture-layer="connectors"></g>
          <g data-architecture-layer="nodes"></g>
        </svg>
      </div>
    </div>
  </div>
</div>

<script>
  type ArchitectureState = {
    id: string
    title: string
    description: string
    viewBox: string
  }

  type DiagramElementType =
    | 'boundary'
    | 'connector'
    | 'disk'
    | 'label'
    | 'loadBalancer'
    | 'panel'
    | 'service'
    | 'supabaseShell'
    | 'user'

  type DiagramElementDefinition = {
    type: DiagramElementType
    className?: string
    enter?: 'left' | 'right' | 'up' | 'down'
    exit?: 'left' | 'right' | 'up' | 'down'
  }

  type DiagramLayout = {
    x: number
    y: number
    width?: number
    height?: number
    opacity?: number
    text?: string
    path?: string
    labelSide?: 'left' | 'top'
  }

  type DiagramNode = {
    id: string
    definition: DiagramElementDefinition
    element: SVGGElement
    refs: {
      rect?: SVGRectElement
      rect2?: SVGRectElement
      rect3?: SVGRectElement
      text?: SVGTextElement
      text2?: SVGTextElement
      path?: SVGPathElement
    }
    current: Required<Pick<DiagramLayout, 'x' | 'y'>> & {
      width: number
      height: number
      opacity: number
      text: string
      path: string
      labelSide: 'left' | 'top'
    }
  }

  const namespace = 'http://www.w3.org/2000/svg'
  const diagramUnit = 16
  const unit = (units: number) => Number((units * diagramUnit).toFixed(4))
  const formatUnit = (value: number) => Number(value.toFixed(4)).toString()
  const unitPath = (path: string) => path.replace(/-?\d+(?:\.\d+)?/g, (value) => formatUnit(unit(Number(value))))
  const defaultLayout = {
    x: unit(0),
    y: unit(0),
    width: unit(8),
    height: unit(3),
    opacity: 1,
    text: '',
    path: '',
    labelSide: 'top' as const,
  }

  const elements: Record<string, DiagramElementDefinition> = {
    user: { type: 'user', enter: 'left', exit: 'left' },
    frontendBoundary: { type: 'boundary', className: 'boundary--frontend' },
    backendBoundary: { type: 'boundary', className: 'boundary--backend' },
    managedOwner: { type: 'panel', className: 'panel--managed', enter: 'left', exit: 'left' },
    aws: { type: 'panel', className: 'panel--cloud', enter: 'right', exit: 'left' },
    officialSupabase: { type: 'panel', className: 'panel--cloud', enter: 'right', exit: 'left' },
    server1: { type: 'panel', className: 'panel--server', enter: 'right', exit: 'left' },
    server2: { type: 'panel', className: 'panel--server', enter: 'right', exit: 'right' },
    server3: { type: 'panel', className: 'panel--server', enter: 'right', exit: 'right' },
    openSe1: { type: 'service', className: 'service--opense' },
    openSe2: { type: 'service', className: 'service--opense', enter: 'right', exit: 'right' },
    openSe3: { type: 'service', className: 'service--opense', enter: 'right', exit: 'right' },
    loadBalancer1: { type: 'loadBalancer', enter: 'up', exit: 'up' },
    loadBalancer2: { type: 'loadBalancer', enter: 'down', exit: 'down' },
    supabaseShell: { type: 'supabaseShell' },
    disk1: { type: 'disk' },
    disk2: { type: 'disk', enter: 'right', exit: 'right' },
    disk3: { type: 'disk', enter: 'right', exit: 'right' },
    reverseTunnel: { type: 'service', className: 'service--access', enter: 'left', exit: 'left' },
    vpn: { type: 'service', className: 'service--access', enter: 'left', exit: 'left' },
    openPort: { type: 'service', className: 'service--access', enter: 'left', exit: 'left' },
    directAccess: { type: 'service', className: 'service--access', enter: 'left', exit: 'left' },
    sync12: { type: 'label', enter: 'right', exit: 'right' },
    sync23: { type: 'label', enter: 'right', exit: 'right' },
    userToFrontend: { type: 'connector' },
    userToBackend: { type: 'connector' },
    userToAccess: { type: 'connector', enter: 'left', exit: 'left' },
    accessToStack: { type: 'connector', enter: 'left', exit: 'left' },
    accessToTopLoadBalancer: { type: 'connector', enter: 'left', exit: 'left' },
    accessToBottomLoadBalancer: { type: 'connector', enter: 'left', exit: 'left' },
    loadBalancerToOpenSe1: { type: 'connector', enter: 'up', exit: 'up' },
    loadBalancerToOpenSe2: { type: 'connector', enter: 'up', exit: 'up' },
    loadBalancerToOpenSe3: { type: 'connector', enter: 'up', exit: 'up' },
    loadBalancerToSupabase: { type: 'connector', enter: 'down', exit: 'down' },
    syncDisk12: { type: 'connector', enter: 'right', exit: 'right' },
    syncDisk23: { type: 'connector', enter: 'right', exit: 'right' },
  }

  const layouts: Array<Record<string, DiagramLayout>> = [
    {
      user: { x: unit(15), y: unit(10), width: unit(3), height: unit(2), text: 'You' },
      frontendBoundary: { x: unit(22), y: unit(4), width: unit(21), height: unit(6), text: 'Frontend', labelSide: 'left' },
      backendBoundary: { x: unit(22), y: unit(11), width: unit(21), height: unit(8), text: 'Backend', labelSide: 'left' },
      managedOwner: { x: unit(25), y: unit(5), width: unit(17), height: unit(13), text: 'We manage for you' },
      openSe1: { x: unit(26), y: unit(7), width: unit(15), height: unit(2), text: 'Open-Se' },
      supabaseShell: { x: unit(26), y: unit(12), width: unit(15), height: unit(5), text: 'Supabase' },
      disk1: { x: unit(27), y: unit(14), width: unit(13), height: unit(2), text: 'Data' },
      userToFrontend: { x: unit(0), y: unit(0), path: unitPath('M18 11 C21 11 21 8 26 8') },
      userToBackend: { x: unit(0), y: unit(0), path: unitPath('M18 11 C21 11 22 13 26 13') },
    },
    {
      user: { x: unit(14), y: unit(10), width: unit(3), height: unit(2), text: 'You' },
      frontendBoundary: { x: unit(19), y: unit(3), width: unit(23), height: unit(7), text: 'Frontend', labelSide: 'left' },
      backendBoundary: { x: unit(19), y: unit(11), width: unit(23), height: unit(9), text: 'Backend', labelSide: 'left' },
      aws: { x: unit(23), y: unit(4), width: unit(18), height: unit(5), text: 'AWS' },
      officialSupabase: { x: unit(23), y: unit(12), width: unit(18), height: unit(8), text: 'Supabase Cloud' },
      openSe1: { x: unit(24), y: unit(6), width: unit(16), height: unit(2), text: 'Open-Se' },
      supabaseShell: { x: unit(24), y: unit(14), width: unit(16), height: unit(5), text: 'Supabase' },
      disk1: { x: unit(25), y: unit(16), width: unit(14), height: unit(2), text: 'Data' },
      userToFrontend: { x: unit(0), y: unit(0), path: unitPath('M17 11 C20 11 20 7 24 7') },
      userToBackend: { x: unit(0), y: unit(0), path: unitPath('M17 11 C20 11 20 15 24 15') },
    },
    {
      user: { x: unit(16), y: unit(10), width: unit(3), height: unit(2), text: 'You' },
      frontendBoundary: { x: unit(23), y: unit(4), width: unit(21), height: unit(6), text: 'Frontend', labelSide: 'left' },
      backendBoundary: { x: unit(23), y: unit(11), width: unit(21), height: unit(8), text: 'Backend', labelSide: 'left' },
      server1: { x: unit(26), y: unit(5), width: unit(17), height: unit(13), text: 'On-Premises Server' },
      openSe1: { x: unit(27), y: unit(7), width: unit(15), height: unit(2), text: 'Open-Se' },
      supabaseShell: { x: unit(27), y: unit(12), width: unit(15), height: unit(5), text: 'Supabase' },
      disk1: { x: unit(28), y: unit(14), width: unit(13), height: unit(2), text: 'Data' },
      userToFrontend: { x: unit(0), y: unit(0), path: unitPath('M19 11 C22 11 22 8 27 8') },
      userToBackend: { x: unit(0), y: unit(0), path: unitPath('M19 11 C22 11 23 13 27 13') },
    },
    {
      user: { x: unit(3), y: unit(10), width: unit(3), height: unit(2), text: 'You' },
      frontendBoundary: { x: unit(19), y: unit(2), width: unit(41), height: unit(10), text: 'Frontend', labelSide: 'top' },
      backendBoundary: { x: unit(19), y: unit(13), width: unit(41), height: unit(11), text: 'Backend', labelSide: 'left' },
      server1: { x: unit(21), y: unit(4), width: unit(12), height: unit(19), text: 'On-Premises Server' },
      server2: { x: unit(34), y: unit(4), width: unit(12), height: unit(19), text: 'On-Premises Server' },
      server3: { x: unit(47), y: unit(4), width: unit(12), height: unit(19), text: 'On-Premises Server' },
      loadBalancer1: { x: unit(22), y: unit(7), width: unit(36), height: unit(1), text: 'Load Balancer' },
      openSe1: { x: unit(22), y: unit(9), width: unit(10), height: unit(2), text: 'Open-Se1' },
      openSe2: { x: unit(35), y: unit(9), width: unit(10), height: unit(2), text: 'Open-Se2' },
      openSe3: { x: unit(48), y: unit(9), width: unit(10), height: unit(2), text: 'Open-Se3' },
      loadBalancer2: { x: unit(22), y: unit(14), width: unit(36), height: unit(1), text: 'Load Balancer' },
      supabaseShell: { x: unit(22), y: unit(16), width: unit(36), height: unit(6), text: 'Supabase' },
      disk1: { x: unit(23), y: unit(19), width: unit(9), height: unit(2), text: 'Data' },
      disk2: { x: unit(35), y: unit(19), width: unit(10), height: unit(2), text: 'Data' },
      disk3: { x: unit(48), y: unit(19), width: unit(9), height: unit(2), text: 'Data' },
      reverseTunnel: { x: unit(7), y: unit(10), width: unit(7), height: unit(2), text: 'Reverse Tunnel' },
      vpn: { x: unit(7), y: unit(10), width: unit(7), height: unit(2), text: 'VPN' },
      openPort: { x: unit(7), y: unit(10), width: unit(7), height: unit(2), text: 'Open Port' },
      directAccess: { x: unit(7), y: unit(10), width: unit(7), height: unit(2), text: 'Direct Access' },
      sync12: { x: unit(32), y: unit(19), width: unit(3), height: unit(2), text: 'Sync' },
      sync23: { x: unit(45), y: unit(19), width: unit(3), height: unit(2), text: 'Sync' },
      userToFrontend: { x: unit(0), y: unit(0), path: unitPath('M6 11 L8 5 M6 11 L8 10 M6 11 L8 13 M14 5 C18 5 19 7 22 8') },
      userToBackend: { x: unit(0), y: unit(0), path: unitPath('M14 10 C18 10 19 15 22 15 M14 13 C18 13 19 15 22 15') },
      accessToStack: {
        x: unit(0),
        y: unit(0),
        path:
          unitPath('M14 5 C18 5 19 8 22 8 M14 10 C18 10 19 10 22 10 M14 13 C18 13 19 15 22 15 M14 16 C18 16 19 15 22 15'),
      },
      loadBalancerToOpenSe1: { x: unit(0), y: unit(0), path: unitPath('M27 8 V9') },
      loadBalancerToOpenSe2: { x: unit(0), y: unit(0), path: unitPath('M40 8 V9') },
      loadBalancerToOpenSe3: { x: unit(0), y: unit(0), path: unitPath('M53 8 V9') },
      loadBalancerToSupabase: { x: unit(0), y: unit(0), path: unitPath('M40 15 V16') },
      syncDisk12: { x: unit(0), y: unit(0), path: unitPath('M32 20 H35') },
      syncDisk23: { x: unit(0), y: unit(0), path: unitPath('M45 20 H48') },
    },
  ]

  const easeOutCubic = (value: number) => 1 - Math.pow(1 - value, 3)
  const parseViewBox = (viewBox: string) => viewBox.split(/\s+/).map(Number)
  const formatViewBox = (viewBox: number[]) => viewBox.map((value) => value.toFixed(2)).join(' ')

  const createSvgElement = <ElementType extends SVGElement>(tag: string, className?: string) => {
    const element = document.createElementNS(namespace, tag) as ElementType

    if (className) {
      element.setAttribute('class', className)
    }

    return element
  }

  const setAttributes = (element: SVGElement, attributes: Record<string, string | number>) => {
    Object.entries(attributes).forEach(([name, value]) => {
      element.setAttribute(name, String(value))
    })
  }

  const splitLabel = (label: string) => {
    if (label === 'Reverse Tunnel' || label === 'Open Port') {
      return label.split(' ')
    }

    return [label]
  }

  const setText = (textElement: SVGTextElement, label: string, x: number, y: number, lineHeight = 13) => {
    const lines = splitLabel(label)

    textElement.textContent = ''
    textElement.setAttribute('x', String(x))
    textElement.setAttribute('y', String(y - ((lines.length - 1) * lineHeight) / 2))

    lines.forEach((line, index) => {
      const tspan = createSvgElement<SVGTSpanElement>('tspan')
      tspan.textContent = line
      tspan.setAttribute('x', String(x))
      tspan.setAttribute('dy', index === 0 ? '0' : String(lineHeight))
      textElement.appendChild(tspan)
    })
  }

  const drawElement = (node: DiagramNode) => {
    const { current, definition, element, refs } = node
    const width = current.width
    const height = current.height

    element.setAttribute('transform', `translate(${current.x.toFixed(2)} ${current.y.toFixed(2)})`)
    element.style.opacity = String(current.opacity)
    element.toggleAttribute('aria-hidden', current.opacity < 0.04)

    if (definition.type === 'connector') {
      refs.path?.setAttribute('d', current.path)
      return
    }

    if (refs.rect) {
      setAttributes(refs.rect, { width, height })
    }

    if (definition.type === 'boundary') {
      refs.text && setText(refs.text, current.text, current.labelSide === 'top' ? width / 2 : 14, current.labelSide === 'top' ? 16 : height / 2)
      if (refs.text) {
        refs.text.setAttribute(
          'transform',
          current.labelSide === 'left'
            ? `rotate(-90 14 ${height / 2})`
            : 'none',
        )
      }
    }

    if (definition.type === 'panel') {
      refs.text && setText(refs.text, current.text, width / 2, 26)
    }

    if (definition.type === 'service' || definition.type === 'loadBalancer' || definition.type === 'user') {
      refs.text && setText(refs.text, current.text, width / 2, height / 2 + 4)
    }

    if (definition.type === 'label') {
      refs.text && setText(refs.text, current.text, width / 2, height / 2 + 4)
    }

    if (definition.type === 'supabaseShell') {
      refs.text && setText(refs.text, current.text, width / 2, 20)
    }

    if (definition.type === 'disk') {
      refs.text && setText(refs.text, current.text, width / 2, height / 2 + 4)
    }
  }

  const createElementNode = (id: string, definition: DiagramElementDefinition) => {
    const element = createSvgElement<SVGGElement>('g', `architecture-node architecture-node--${definition.type} ${definition.className ?? ''}`)
    element.dataset.diagramElement = id

    const refs: DiagramNode['refs'] = {}

    if (definition.type === 'connector') {
      refs.path = createSvgElement<SVGPathElement>('path')
      refs.path.setAttribute('marker-end', 'url(#architecture-arrow)')
      element.appendChild(refs.path)
    } else if (definition.type === 'disk') {
      refs.rect = createSvgElement<SVGRectElement>('rect', 'architecture-node__disk-outer')
      refs.text = createSvgElement<SVGTextElement>('text', 'architecture-node__text architecture-node__text--data')
      element.append(refs.rect, refs.text)
    } else {
      if (definition.type !== 'label') {
        refs.rect = createSvgElement<SVGRectElement>('rect')
        element.appendChild(refs.rect)
      }

      refs.text = createSvgElement<SVGTextElement>('text', 'architecture-node__text')
      element.appendChild(refs.text)
    }

    const node: DiagramNode = {
      id,
      definition,
      element,
      refs,
      current: { ...defaultLayout },
    }

    drawElement(node)

    return node
  }

  const directionOffset = (direction: DiagramElementDefinition['enter'] = 'right') => {
    if (direction === 'left') {
      return { x: unit(-6), y: unit(0) }
    }

    if (direction === 'up') {
      return { x: unit(0), y: unit(-3) }
    }

    if (direction === 'down') {
      return { x: unit(0), y: unit(3) }
    }

    return { x: unit(6), y: unit(0) }
  }

  const completeLayout = (layout?: DiagramLayout) => ({ ...defaultLayout, ...layout })

  const getEnteringLayout = (node: DiagramNode, target: DiagramLayout) => {
    const offset = directionOffset(node.definition.enter)
    const layout = completeLayout(target)

    return { ...layout, x: layout.x + offset.x, y: layout.y + offset.y, opacity: 0 }
  }

  const getExitingLayout = (node: DiagramNode) => {
    const offset = directionOffset(node.definition.exit)

    return {
      ...node.current,
      x: node.current.x + offset.x,
      y: node.current.y + offset.y,
      opacity: 0,
    }
  }

  const setupArchitectureAnimator = (root: HTMLElement) => {
    if (root.dataset.ready === 'true') {
      return
    }

    root.dataset.ready = 'true'

    const states = JSON.parse(root.dataset.states ?? '[]') as ArchitectureState[]
    const svg = root.querySelector<SVGSVGElement>('[data-architecture-diagram]')
    const connectorLayer = svg?.querySelector<SVGGElement>('[data-architecture-layer="connectors"]')
    const nodeLayer = svg?.querySelector<SVGGElement>('[data-architecture-layer="nodes"]')
    const controls = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-architecture-control]'))
    const modeButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-architecture-mode]'))
    const optionGroups = Array.from(root.querySelectorAll<HTMLElement>('[data-architecture-option-group]'))
    const providerGroup = root.querySelector<HTMLElement>('[data-architecture-provider-group]')
    const providerButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-architecture-provider]'))
    const accessGroup = root.querySelector<HTMLElement>('[data-architecture-access-group]')
    const accessButtons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-architecture-access]'))
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const stateModes = ['cloud', 'cloud', 'on-premise', 'on-premise'] as const
    const modeDefaults: Record<(typeof stateModes)[number], number> = {
      cloud: 0,
      'on-premise': 2,
    }

    if (!svg || !connectorLayer || !nodeLayer || states.length === 0) {
      return
    }

    const nodes = Object.entries(elements).map(([id, definition]) => {
      const node = createElementNode(id, definition)
      const layer = definition.type === 'connector' ? connectorLayer : nodeLayer
      layer.appendChild(node.element)

      return node
    })

    let activeIndex = 0
    let activeProvider = 'AWS'
    let activeAccess = 'Reverse Tunnel'
    let frame = 0

    const getHighAvailabilityLayouts = () => {
      const {
        reverseTunnel,
        vpn,
        openPort,
        directAccess,
        userToFrontend,
        userToBackend,
        accessToStack,
        ...baseLayout
      } = layouts[3]
      const accessLayouts = {
        'Reverse Tunnel': {
          id: 'reverseTunnel',
          layout: reverseTunnel,
        },
        VPN: {
          id: 'vpn',
          layout: vpn,
        },
        'Open Port': {
          id: 'openPort',
          layout: openPort,
        },
        'Direct Access': {
          id: 'directAccess',
          layout: directAccess,
        },
      } as const
      const selectedAccess = accessLayouts[activeAccess as keyof typeof accessLayouts] ?? accessLayouts['Reverse Tunnel']

      return {
        ...baseLayout,
        [selectedAccess.id]: selectedAccess.layout,
        userToAccess: { x: unit(0), y: unit(0), path: unitPath('M6 11 H7') },
        accessToTopLoadBalancer: { x: unit(0), y: unit(0), path: unitPath('M14 11 C17 11 19 8 22 8') },
        accessToBottomLoadBalancer: { x: unit(0), y: unit(0), path: unitPath('M14 11 C17 11 19 15 22 15') },
      }
    }

    const getTargetLayouts = (index: number) => {
      if (index === 1) {
        return { ...layouts[index], aws: { ...layouts[index].aws, text: activeProvider } }
      }

      if (index === 3) {
        return getHighAvailabilityLayouts()
      }

      return layouts[index]
    }

    const setActiveText = (index: number) => {
      const mode = stateModes[index]

      activeIndex = index
      root.dataset.activeMode = mode
      root.dataset.activeState = states[index].id

      modeButtons.forEach((button) => {
        button.setAttribute('aria-selected', button.dataset.architectureMode === mode ? 'true' : 'false')
      })

      optionGroups.forEach((group) => {
        group.hidden = group.dataset.architectureOptionGroup !== mode
      })

      if (providerGroup) {
        providerGroup.hidden = index !== 1
      }

      if (accessGroup) {
        accessGroup.hidden = index !== 3
      }

      controls.forEach((control) => {
        const controlIndex = Number(control.dataset.architectureControl)
        control.setAttribute('aria-selected', controlIndex === index ? 'true' : 'false')
      })

      providerButtons.forEach((button) => {
        button.setAttribute('aria-selected', button.dataset.architectureProvider === activeProvider ? 'true' : 'false')
      })

      accessButtons.forEach((button) => {
        button.setAttribute('aria-selected', button.dataset.architectureAccess === activeAccess ? 'true' : 'false')
      })
    }

    const applyState = (index: number, immediate = false) => {
      window.cancelAnimationFrame(frame)
      setActiveText(index)

      const targetLayouts = getTargetLayouts(index)
      const fromViewBox = parseViewBox(svg.getAttribute('viewBox') ?? states[activeIndex]?.viewBox ?? states[0].viewBox)
      const toViewBox = parseViewBox(states[index].viewBox)
      const animationNodes = nodes.map((node) => {
        const target = targetLayouts[node.id]
        const from = node.current.opacity <= 0.04 && target ? getEnteringLayout(node, target) : { ...node.current }
        const to = target ? completeLayout(target) : getExitingLayout(node)

        if (target?.text) {
          node.current.text = target.text
        }

        if (target?.path) {
          node.current.path = target.path
        }

        return { node, from, to }
      })

      if (immediate || reduceMotion) {
        svg.setAttribute('viewBox', states[index].viewBox)
        animationNodes.forEach(({ node, to }) => {
          node.current = to
          drawElement(node)
        })
        return
      }

      const start = performance.now()
      const duration = 720

      const tick = (now: number) => {
        const progress = Math.min((now - start) / duration, 1)
        const eased = easeOutCubic(progress)
        const nextViewBox = fromViewBox.map((value, valueIndex) => value + (toViewBox[valueIndex] - value) * eased)

        svg.setAttribute('viewBox', formatViewBox(nextViewBox))

        animationNodes.forEach(({ node, from, to }) => {
          node.current = {
            x: from.x + (to.x - from.x) * eased,
            y: from.y + (to.y - from.y) * eased,
            width: from.width + (to.width - from.width) * eased,
            height: from.height + (to.height - from.height) * eased,
            opacity: from.opacity + (to.opacity - from.opacity) * eased,
            text: to.text,
            path: to.path,
            labelSide: to.labelSide,
          }
          drawElement(node)
        })

        if (progress < 1) {
          frame = window.requestAnimationFrame(tick)
        }
      }

      frame = window.requestAnimationFrame(tick)
    }

    modeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.dataset.architectureMode as keyof typeof modeDefaults

        applyState(modeDefaults[mode] ?? 0)
      })
    })

    controls.forEach((control) => {
      control.addEventListener('click', () => {
        applyState(Number(control.dataset.architectureControl))
      })
    })

    providerButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeProvider = button.dataset.architectureProvider ?? 'AWS'
        applyState(1)
      })
    })

    accessButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeAccess = button.dataset.architectureAccess ?? 'Reverse Tunnel'
        applyState(3)
      })
    })

    applyState(0, true)
  }

  document.querySelectorAll<HTMLElement>('[data-architecture-animator]').forEach(setupArchitectureAnimator)
</script>

