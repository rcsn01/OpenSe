{
  "name": "open-pi",
  "productName": "Open Pi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "desktop": "pnpm desktop:dev",
    "desktop:dev": "concurrently -k -n web,desktop -c green,magenta \"pnpm dev\" \"OPEN_PI_DESKTOP_DEV=1 electron electron/main.cjs\"",
    "desktop:preview": "pnpm build && OPEN_PI_DESKTOP_DIST=dist electron electron/main.cjs",
    "package": "pnpm build && electron-builder --mac --win --linux",
    "package:all": "pnpm package",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.opense.pi",
    "productName": "Open Pi",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    }
  },
  "dependencies": {
    "@repo/shared": "link:../../packages/shared",
    "@repo/ui": "link:../../packages/ui",
    "@tailwindcss/postcss": "4.1.18",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "5.5.0",
    "autoprefixer": "10.4.24",
    "concurrently": "9.2.1",
    "lucide-react": "0.563.0",
    "node-pty": "^1.0.0",
    "postcss": "8.5.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.13.0",
    "tailwindcss": "4.1.18",
    "virtua": "0.49.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@repo/typescript-config": "link:../../packages/typescript-config",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "28.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "electron": "42.3.0",
    "electron-builder": "26.8.1",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
