# Supabase - shared across all apps
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

SUPABASE_SERVICE_ROLE_KEY=sb_secret_....

# Stripe (optional - for ETL subscriptions)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Shared auth host (used by ETL + StoQR redirects)
VITE_ACCOUNTS_URL=http://localhost:5991

# Public app URLs used for post-login return redirects (VITE_ prefix required for client)
VITE_OPENSE_PUBLIC_URL=http://localhost:5994
VITE_ETL_PUBLIC_URL=http://localhost:5992
VITE_STOQR_PUBLIC_URL=http://localhost:5993
VITE_ADMIN_PUBLIC_URL=http://localhost:5990
VITE_UI_PUBLIC_URL=http://localhost:5999

# Comma-separated browser origins allowed to call authenticated Edge Functions
EDGE_ALLOWED_ORIGINS=http://localhost:5990,http://localhost:5991,http://localhost:5992,http://localhost:5993,http://localhost:5994,http://localhost:5999

# StoQR alert connector gateway
CONNECTOR_GATEWAY_URL=http://localhost:6075
CONNECTOR_GATEWAY_TOKEN=change-me
CONNECTOR_SESSION_DIR=./apps/alert-connectors/sessions
TELEGRAM_BOT_TOKEN=
ALERT_EMAIL_DISPATCH_TOKEN=change-me-too
# JSON map from Mattermost target keys to incoming webhook URLs, e.g.
# {"warehouse":"https://mattermost.example/hooks/..."}
MATTERMOST_WEBHOOKS_JSON={}
# Optional Mattermost bot API mode, used by StoQR targets whose provider target ID is channel:<channel-id>.
MATTERMOST_BASE_URL=
MATTERMOST_BOT_TOKEN=
