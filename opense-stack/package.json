{
  "name": "opense-stack",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:accounts": "turbo run dev --filter=@repo/accounts",
    "dev:admin": "turbo run dev --filter=@repo/admin",
    "dev:etl": "turbo run dev --filter=@repo/etl",
    "dev:stoqr": "kill-port 5992 || true && turbo run dev --filter=@repo/stoqr",
    "dev:ui-design": "turbo run dev --filter=@repo/ui-design",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "npx playwright test --config=tests/tests/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --config=tests/tests/playwright.config.ts --ui",
    "security:check-secrets": "node scripts/check-secret-leaks.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:status": "supabase status"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint": "^9.39.1",
    "kill-port": "^2.0.1",
    "prettier": "^3.2.5",
    "supabase": "^2.22.0",
    "turbo": "^2.8.3"
  }
}
