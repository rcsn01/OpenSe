{
  "name": "opense-stack",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:etl": "turbo run dev --filter=@repo/etl",
    "dev:stoqr": "turbo run dev --filter=@repo/stoqr",
    "dev:ui-design": "turbo run dev --filter=@repo/ui-design",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:status": "supabase status"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "prettier": "^3.2.5",
    "turbo": "^2.8.3",
    "supabase": "^2.22.0"
  }
}
