# E2E Test Environment Variables
# Copy this file to .env.test and fill in your values

# Test user credentials
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=testpassword123

# Super-admin credentials (Admin app)
E2E_SUPER_ADMIN_EMAIL=super-admin@example.com
E2E_SUPER_ADMIN_PASSWORD=testpassword123

# Optional non-super-admin user for access checks
E2E_NON_ADMIN_EMAIL=user@example.com
E2E_NON_ADMIN_PASSWORD=testpassword123

# Demo user (if different from test user)
E2E_DEMO_EMAIL=demo@example.com
E2E_DEMO_PASSWORD=demo

# Base URLs
BASE_URL_ACCOUNTS=http://localhost:5990
BASE_URL_ETL=http://localhost:5991
BASE_URL_STOQR=http://localhost:5992
BASE_URL_ADMIN=http://localhost:5993

# If true, Playwright will also start Accounts app via `pnpm dev:accounts`
E2E_WITH_ACCOUNTS=true
