#!/bin/sh
set -eu

should_build_main=0

while read local_ref local_sha remote_ref remote_sha
do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    should_build_main=1
  fi
done

if [ "$should_build_main" != "1" ]; then
  exit 0
fi

echo "Pushing to main: running local production Docker builds first..."
pnpm --dir src docker:build
