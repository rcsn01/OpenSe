MADDY_HOSTNAME=mail.rcsn01.com
MADDY_DOMAIN=rcsn01.com
MADDY_PLATFORM=linux/amd64

# Maddy reads these certificate files from inside the container.
# docker-compose.yml mounts /etc/letsencrypt from the host as read-only.
MADDY_TLS_CERT_FILE=/etc/letsencrypt/live/mail.rcsn01.com/fullchain.pem
MADDY_TLS_KEY_FILE=/etc/letsencrypt/live/mail.rcsn01.com/privkey.pem

# Outbound smarthost used after Gmail rejected direct delivery from the home IP.
# Keep real credentials in mail/.env only; do not commit them.
MADDY_RELAY_HOST=mail.tpg.com.au
MADDY_RELAY_PORT=465
MADDY_RELAY_USERNAME=
MADDY_RELAY_PASSWORD=

# Override these only when host ports need to move.
MADDY_SMTP_PORT=25
MADDY_IMAP_PORT=143
MADDY_SUBMISSIONS_PORT=465
MADDY_SUBMISSION_PORT=587
MADDY_IMAPS_PORT=993
