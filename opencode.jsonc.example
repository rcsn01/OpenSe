{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "plane": {
      "type": "local",
      "command": ["uvx", "plane-mcp-server", "stdio"],
      "enabled": true,
      "environment": {
        "PLANE_API_KEY": "${PLANE_API_KEY}",
        "PLANE_WORKSPACE_SLUG": "open-se",
        "PLANE_BASE_URL": "https://plane.rcsn01.com"
      }
    }
  }
}
