# Public browser runtime configuration
VITE_SUPABASE_URL=https://supabase.example.com/
VITE_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key
VITE_GOOGLE_AUTH_ENABLED=false
VITE_AUTH_COOKIE_DOMAIN=
VITE_ACCOUNTS_URL=http://localhost:5991
VITE_ETL_PUBLIC_URL=http://localhost:5992
VITE_OPEN_KB_PUBLIC_URL=http://localhost:5995
VITE_OPENSE_PUBLIC_URL=http://localhost:5994
VITE_STOQR_PUBLIC_URL=http://localhost:5993
VITE_UI_PUBLIC_URL=http://localhost:5999

# Server-side only. Never expose this value through frontend runtime config.
OPENSE_SELF_HOSTED_SUPABASE_DB_URL=postgresql://postgres.example:password@database.example.com:5432/postgres?sslmode=disable
